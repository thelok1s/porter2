# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Env / secrets — never commit
.env
.env.local
.env.*.local

# Private local modules — deployment-specific, NOT part of the reusable core.
# `all-command` and `frontend` are tracked as private git submodules (see
# .gitmodules); everything else under local/ stays gitignored and is mounted at
# runtime by the module loader. See local/README.md.
local/*
!local/README.md
!local/.example/
!local/all-command
!local/frontend

# Runtime data
logs/
*.log
db/*.sqlite
db/*.sqlite-journal
uploads/
data/
*.sqlite

# MTProto session — an auth key in a SQLite file. Committing it hands over the
# account it was signed in with, so match the WAL sidecars too.
*.session
*.session-shm
*.session-wal

# VK ID grant — holds a REFRESH TOKEN, which is password-grade: whoever has it
# can act as the account that authorized it, within `photos wall`, and renew
# indefinitely. Never commit it. Revoke at https://vk.ru/settings?act=apps
db/vkid.json
vkid.json

# Editor / OS
.DS_Store
.idea/
.vscode/
docs/specs/

# Superseded by db/vkuser.json; kept ignored so old deployments do not commit it.
db/vktoken.json

# Exported VK browser session used to renew the user token. ACCOUNT-GRADE:
# whoever holds this IS the account. Never commit.
db/vkcookies.txt
db/vkuser.json
